# ─── Application ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=FoodMarket
APP_VERSION=1.2.0
APP_URL=http://localhost:3000

# ─── Monitoring ────────────────────────────────────────────
SENTRY_DSN=
API_URL=http://localhost:4000
API_PREFIX=api/v1

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://foodmarket:foodmarket_secret@localhost:5432/foodmarket?schema=public

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Web middleware must verify JWT with the same secret as the API
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ─── File uploads / CDN ────────────────────────────────────
UPLOAD_DIR=./uploads
CDN_BASE_URL=
MAX_FILE_SIZE=5242880

# ─── Delivery ──────────────────────────────────────────────
BASE_DELIVERY_FEE=15000
PER_KM_FEE=3000
FREE_DELIVERY_THRESHOLD=200000
MIN_ORDER_AMOUNT=50000
MAX_DELIVERY_RADIUS_KM=12

# Telegram bot (operational alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ADMIN=
TELEGRAM_CHAT_ORDERS=
TELEGRAM_CHAT_COURIERS=
TELEGRAM_CHAT_RESTAURANTS=
TELEGRAM_CHAT_OPERATORS=

# DigitalOcean Spaces (S3-compatible)
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=foodmarket
DO_SPACES_KEY=
DO_SPACES_SECRET=
CDN_BASE_URL=https://foodmarket.fra1.cdn.digitaloceanspaces.com

# ─── Push notifications (FCM) ──────────────────────────────
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── Email (optional) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@foodmarket.local

# ─── Unified frontend (single Next.js app on :3000) ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Legacy path URLs (same origin):
#   /           customer
#   /admin      admin panel
#   /courier    courier panel
#   /business   business panel
#   /restaurant restaurant panel

# ─── Scaling preparation (optional, no K8s required) ───────
# Read replica for analytics/reporting queries
DATABASE_READ_URL=
# Socket.IO Redis adapter for multi-instance API
REDIS_WS_ADAPTER_URL=
# BullMQ worker concurrency per process
WORKER_CONCURRENCY=2
# Slow query log threshold (ms)
SLOW_QUERY_MS=500

# ─── Docker production ─────────────────────────────────────
POSTGRES_USER=foodmarket
POSTGRES_PASSWORD=foodmarket_secret
POSTGRES_DB=foodmarket
