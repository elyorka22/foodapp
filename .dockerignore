# Rebuilt inside Docker images
node_modules
**/node_modules
**/.next
.turbo
**/dist
**/*.tsbuildinfo

# Git & IDE
.git
.github
.cursor

# Secrets (provided via env_file at runtime)
.env
.env.*
!.env.example

# Logs & coverage
**/*.log
coverage

# NOTE: Do NOT exclude apps/api, packages/database, or packages/shared-types.
# Backend API/worker images require those paths in the build context.
