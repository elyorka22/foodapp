FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY workers/package.json ./workers/
COPY packages/database/package.json ./packages/database/
RUN npm ci --workspace=foodmarket-workers --workspace=@foodmarket/database --include-workspace-root 2>/dev/null || npm install --workspace=foodmarket-workers --workspace=@foodmarket/database --include-workspace-root

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run db:generate 2>/dev/null || true
RUN npm run build -w foodmarket-workers

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/workers/dist ./workers/dist
COPY --from=builder /app/workers/package.json ./workers/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/database ./packages/database
CMD ["node", "workers/dist/index.js"]
