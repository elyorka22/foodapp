ARG APP_NAME=customer
ARG APP_PORT=3000
FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
ARG APP_NAME
COPY package.json package-lock.json* ./
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/
COPY packages/ui/package.json ./packages/ui/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN npm ci --workspace=@foodmarket/${APP_NAME} --workspace=@foodmarket/ui --include-workspace-root 2>/dev/null || npm install --workspace=@foodmarket/${APP_NAME} --workspace=@foodmarket/ui --include-workspace-root

FROM base AS builder
ARG APP_NAME
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @foodmarket/${APP_NAME}

FROM node:20-alpine AS runner
ARG APP_NAME
ARG APP_PORT
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${APP_PORT}
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/${APP_NAME}/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./.next/static
USER nextjs
EXPOSE ${APP_PORT}
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
