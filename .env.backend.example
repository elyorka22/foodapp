# Backend droplet — copy to .env

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

POSTGRES_USER=foodapp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=foodapp
DATABASE_URL=postgresql://foodapp:change-me-strong-password@postgres:5432/foodapp?schema=public

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Single frontend origin (browser login + API calls)
CORS_ORIGINS=https://foodapp.uz

# Optional — leave empty to disable Telegram ops alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ORDERS=

# Optional product images (DigitalOcean Spaces)
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
CDN_BASE_URL=
